#!/bin/bash
# Copy this file to env.sh, fill in the paths/token below, then `source env.sh`.

# Repo root
export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Model checkpoints
export QWEN_CHECKPOINT="Qwen/Qwen2-Audio-7B-Instruct"
export AF3_CHECKPOINT="nvidia/audio-flamingo-3-hf"  # transformers-native release, not nvidia/audio-flamingo-3
export VOXTRAL_CHECKPOINT="mistralai/Voxtral-Mini-3B-2507"

# Model / data paths
export RESULTS_DIR="${REPO_ROOT}/results"
export CALIBRATION_DATA_DIR="${REPO_ROOT}/calibration"
export CALIBRATION_DATASET_PATH="/path/to/calibration_dataset" # the path to dataset created by running SpeechLLM_compression/calibration/create_calibration_set.py
export BI_SCORES_DIR="${REPO_ROOT}/layer_BI"
export ASR_DATASET_PATH="/path/to/asr_dataset"

# Optional flags
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
# export HF_HOME="${REPO_ROOT}/.cache/huggingface"
export HF_TOKEN="hf_your_token_here"
export PYTHONPATH="${REPO_ROOT}:${PYTHONPATH}"
